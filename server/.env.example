PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/finance-tax-community
# Optional: set custom DNS resolvers only if your network cannot resolve Atlas SRV records.
# MONGODB_DNS_SERVERS=8.8.8.8,8.8.4.4
JWT_SECRET=replace-with-secure-secret
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000
ADMIN_EMAIL=your-admin-email
WHATSAPP_NUMBER=your-whatsapp-number
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud
CLOUDINARY_API_KEY=your-cloudinary-key
CLOUDINARY_API_SECRET=your-cloudinary-secret
RESEND_API_KEY=your-resend-key
RESEND_FROM_EMAIL=Aloka <notifications@example.com>
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
# Optional news providers. Add only feeds you are authorized to display.
NEWS_FETCH_ENABLED=true
NEWS_FETCH_CRON=*/15 * * * *
NEWS_FETCH_TIMEZONE=Asia/Kolkata
NEWS_RSS_FEEDS=
GNEWS_API_KEY=
NEWSAPI_API_KEY=
NEWS_GNEWS_QUERY=finance OR tax OR GST OR markets OR banking OR economy
NEWS_GNEWS_LANGUAGE=en
NEWS_GNEWS_COUNTRY=in
NEWS_GNEWS_MAX_RESULTS=10
NEWSAPI_QUERY=finance OR tax OR GST OR markets OR banking OR economy
NEWSAPI_LANGUAGE=en
NEWSAPI_COUNTRY=IN
NEWSAPI_MAX_RESULTS=30
# Comma-separated publisher image/CDN hosts explicitly approved for display.
NEWS_IMAGE_HOSTS=static.toiimg.com,s.yimg.com,bl-i.thgim.com,img.etimg.com
NEWS_AUTO_PUBLISH=true
NEWS_FETCH_TIMEOUT_MS=15000
NEWS_FETCH_MAX_RETRIES=2
NEWS_FETCH_BATCH_SIZE=50
NEWS_SEARCH_DEFAULT_LIMIT=20
NEWS_SEARCH_MAX_LIMIT=50